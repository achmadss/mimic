# App settings only. API keys, bot tokens and models are set in the dashboard
# (Settings, and each character's page) and stored in the database.
# Upgrading from an older setup? Keys/tokens still listed here (TYPESAFE_API_KEY,
# LLM_*, RICK_TELEGRAM_TOKEN, ...) are copied into the database once at start;
# delete them from this file afterwards.
DB_PATH=mimic.db

# Optional tuning overrides (defaults live in src/config.ts)
# MIMIC_QUIET_MS=2500
# MIMIC_FOLLOW_UP_THRESHOLD=0.6
# MIMIC_OPEN_THREAD_THRESHOLD=0.6

# Dashboard: http://127.0.0.1:8787 while the bot runs. DASHBOARD=off to disable.
# It listens on every interface (0.0.0.0), so DASHBOARD_PASSWORD is required
# (browser login as DASHBOARD_USER, default admin). DASHBOARD_HOST=127.0.0.1 keeps it on this machine, no password.
DASHBOARD_PASSWORD=
# DASHBOARD_USER=admin
# DASHBOARD_PORT=8787
# DASHBOARD_HOST=0.0.0.0
