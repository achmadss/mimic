TYPESAFE_API_KEY=
LLM_BASE_URL=https://opencode.ai/zen/go/v1
LLM_API_KEY=
# pick one from GET {LLM_BASE_URL}/models
LLM_MODEL=
# json_schema | tool | json_object
# On OpenCode Go, json_schema is NOT reliable for every model: deepseek-v4.1-flash answers 400
# on roughly half of all requests (measured 5/10) while tool and json_object pass 10/10.
# Use "tool" unless you have verified json_schema end to end for your model.
LLM_STRUCTURED_MODE=tool
DB_PATH=mimic.db
# One block per character in characters/*.json — the names come from that file's
# `platforms.<platform>.botTokenEnv`, so a new character just declares its own.
# Leave a platform blank to skip it; set neither and use `npm run cli -- <id>`.
RICK_TELEGRAM_TOKEN=
RICK_DISCORD_TOKEN=
MORTY_TELEGRAM_TOKEN=
MORTY_DISCORD_TOKEN=
# characters/_template.json → copy it to <id>.json and uncomment:
# NADIA_TELEGRAM_TOKEN=

# Optional tuning overrides (defaults live in src/config.ts)
# MIMIC_QUIET_MS=2500
# MIMIC_FOLLOW_UP_THRESHOLD=0.6
# MIMIC_OPEN_THREAD_THRESHOLD=0.6

# Dashboard: http://127.0.0.1:8787 while the bot runs. DASHBOARD=off to disable.
# Binding anywhere but localhost requires DASHBOARD_PASSWORD (browser login, any user name).
# DASHBOARD_PORT=8787
# DASHBOARD_HOST=127.0.0.1
# DASHBOARD_PASSWORD=          # required with Docker
# Where the dashboard writes bot tokens (default .env).
# MIMIC_ENV_FILE=.env
