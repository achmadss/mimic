TYPESAFE_API_KEY=
LLM_BASE_URL=https://opencode.ai/zen/go/v1
LLM_API_KEY=
# pick one from GET {LLM_BASE_URL}/models
LLM_MODEL=
# json_schema | tool | json_object
# On OpenCode Go, json_schema is NOT reliable for every model: deepseek-v4.1-flash answers 400
# on roughly half of all requests (measured 5/10) while tool and json_object pass 10/10.
# Use "tool" unless you have verified json_schema end to end for your model.
LLM_STRUCTURED_MODE=tool
DB_PATH=mimic.db
RICK_TELEGRAM_TOKEN=
RICK_DISCORD_TOKEN=
MORTY_TELEGRAM_TOKEN=
MORTY_DISCORD_TOKEN=
